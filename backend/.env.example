# ============================================================
# Backend Environment Variables
# Copy this file to .env and fill in your credentials.
# ============================================================

# --- Application ---
APP_NAME="Travel Planner API"
APP_ENV=development
DEBUG=true

# --- Supabase ---
# Project URL → Supabase dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co
# Anon (public) key → Settings → API → Project API keys → anon / public
SUPABASE_KEY=your-supabase-anon-key
# Service-role key (optional – only needed for admin operations)
# ⚠️  Never expose this key on the client side
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# JWT secret → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Google Gemini AI ---
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-google-gemini-api-key

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
